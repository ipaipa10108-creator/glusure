# API URL for Google Apps Script Web App
# Get this from Deployment -> Web App URL
VITE_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# (Option) Turso Database URL and Auth Token
# 如果設定了 Turso 的連線資訊，系統將改用 Turso 作為預設資料庫。
# 並且在設定頁會出現「從 Google Sheets 轉移資料」功能。
VITE_TURSO_DATABASE_URL=libsql://your-db-name-username.turso.io
VITE_TURSO_AUTH_TOKEN=your_auth_token_here
